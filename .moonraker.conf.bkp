[server]
host = 0.0.0.0
port = 7125
klippy_uds_address = /home/user/printer_data/comms/klippy.sock

[file_manager]
enable_object_processing = True

[authorization]
trusted_clients = 
	127.0.0.1
	192.168.88.0/24
	FE80::/10
	::1/128
cors_domains = 
	*.lan
	*.local
	*.192.168.88.29:7125
	*://my.mainsail.xyz
	*://app.fluidd.xyz
	*://dev-app.fluidd.xyz

[octoprint_compat]

[history]

[update_manager]
channel = dev
refresh_interval = 168

[update_manager fluidd]
path = /home/user/fluidd
repo = fluidd-core/fluidd
channel = stable
type = web

[update_manager fluidd-config]
managed_services = klipper
origin = https://github.com/fluidd-core/fluidd-config.git
path = /home/user/fluidd-config
primary_branch = master
type = git_repo

[update_manager KlipperScreen]
type = git_repo
path = /home/user/KlipperScreen
origin = https://github.com/KlipperScreen/KlipperScreen.git
env = /home/user/.KlipperScreen-env/bin/python
requirements = scripts/KlipperScreen-requirements.txt
install_script = scripts/KlipperScreen-install.sh

[update_manager crowsnest]
type = git_repo
path = ~/crowsnest
origin = https://github.com/mainsail-crew/crowsnest.git
managed_services = crowsnest
install_script = tools/pkglist.sh

[update_manager moonraker-telegram-bot]
install_script = scripts/install.sh
requirements = scripts/requirements.txt
env = /home/user/moonraker-telegram-bot-env/bin/python
origin = https://github.com/nlef/moonraker-telegram-bot.git
path = /home/user/moonraker-telegram-bot
type = git_repo

[update_manager mainsail]
path = /home/user/mainsail
repo = mainsail-crew/mainsail
channel = stable
type = web

